<!--pages/settle/settle.wxml-->
<wxs module="priceHelper" src="../../utils/priceHelper.wxs"></wxs>
<view class="page">
  <!-- 配送方式 -->
  <view class="section">
    <view class="section-title">配送方式</view>
    <view class="delivery-row">
      <text class="delivery-text">{{isDiyOrder ? '外卖配送（DIY套餐）' : (deliveryType === 'dineIn' ? '堂食/自取' : '外卖配送')}}</text>
      <text class="delivery-switch-text" wx:if="{{!isDiyOrder}}" bindtap="switchDeliveryType" style="color: {{themeColor}}; border-color: {{themeColor}};">切换</text>
    </view>
  </view>

  <!-- 取餐/配送时间 -->
  <view class="section">
    <view class="section-title">{{deliveryType === 'dineIn' ? '取餐时间' : '配送时间'}}</view>
    <view class="time-row" bindtap="showTimePicker">
      <text class="time-value" style="{{selectedTime ? '' : 'color: #ccc;'}}">{{selectedTime || '请选择时间'}}</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 外卖地址选择（仅外卖时显示，DIY 订单强制外卖） -->
  <block wx:if="{{deliveryType === 'takeout'}}">
    <view class="section">
      <view class="section-title">收货地址</view>
      <view class="address-info" bindtap="chooseAddress" wx:if="{{!selectedAddress}}">
        <text class="placeholder">+ 点击选择收货地址</text>
      </view>
      <view class="address-info selected" bindtap="chooseAddress" wx:else>
        <view class="name-phone">{{selectedAddress.name}} {{selectedAddress.phone}}</view>
        <view class="detail">{{selectedAddress.address || selectedAddress.detail || selectedAddress.locationName}}</view>
      </view>
    </view>
    <view class="section">
      <view class="delivery-fee-row">
        <text class="delivery-fee-label">配送费：</text>
        <text class="delivery-fee-value" wx:if="{{deliveryFee > 0}}">¥{{deliveryFee}}</text>
        <text class="delivery-fee-value free" wx:else style="color: {{themeColor}};">免费</text>
      </view>
      <view class="delivery-fee-tip" wx:if="{{freeDeliveryThreshold > 0 && totalPrice < freeDeliveryThreshold}}">
        <text class="delivery-fee-tip-text">再购¥{{priceHelper.formatPrice(freeDeliveryThreshold - totalPrice)}}可免配送费，满¥{{freeDeliveryThreshold}}免配送费</text>
      </view>
      <view class="delivery-fee-tip" wx:if="{{isDiyOrder}}">
        <text class="delivery-fee-tip-text">{{diyFeeTip}}</text>
      </view>
    </view>
  </block>

  <!-- 订单备注 -->
  <view class="section">
    <view class="section-title">订单备注</view>
    <textarea class="remark-input" placeholder="选填，如：不要辣、加急等" maxlength="50" value="{{remark}}" bindinput="onRemarkInput" />
  </view>

  <!-- 订单商品列表 -->
  <view class="section">
    <view class="section-title-wrapper">
      <text class="section-title">订单明细</text>
      <view class="edit-order-btn" bindtap="editOrder" style="color: {{themeColor}};">修改</view>
    </view>
    <view class="goods-list">
      <view class="goods-item" wx:for="{{orderGoods}}" wx:key="dishId">
        <image class="goods-image" src="{{item.dishImage}}" mode="aspectFill"></image>
        <view class="goods-info">
          <view class="goods-name-row">
            <text class="goods-name">{{item.dishName}}</text>
            <!-- 全场自定义折扣对所有支付方式生效 -->
            <text class="no-discount-badge custom" wx:if="{{item.customDiscount > 0 && item.customDiscount < 100 && (payMethod === 'wechat' || item.noMemberDiscount || item.customDiscount < 95)}}">全场{{item.customDiscountText}}折</text>
          </view>
          <view class="goods-tags" wx:if="{{item.tags && item.tags.length > 0}}">
            <van-tag type="danger" wx:for="{{item.tags}}" wx:key="index" wx:for-item="tagVal">{{tagVal}}</van-tag>
          </view>
          <view class="goods-price-count">
            <!-- 各支付方式显示对应折后价：余额按最优折扣，微信按全场折扣 -->
            <block wx:if="{{userBalance > 0 && (payMethod === 'balance' || payMethod === 'mix') && item.balDiscounted}}">
              <text class="goods-price-balance" style="color: {{themeColor}};">¥{{item.balancePrice}}</text>
              <text class="goods-price-original">¥{{item.price}}</text>
            </block>
            <block wx:elif="{{payMethod === 'wechat' && item.wxDiscounted}}">
              <text class="goods-price-balance" style="color: {{themeColor}};">¥{{item.wxPrice}}</text>
              <text class="goods-price-original">¥{{item.price}}</text>
            </block>
            <text class="goods-price" wx:else style="color: {{themeColor}};">¥{{item.price}}</text>
            <text class="goods-count">×{{item.count}}</text>
          </view>
        </view>
        <!-- 各支付方式显示对应折后小计和原小计 -->
        <view class="goods-subtotal-wrap" wx:if="{{userBalance > 0 && (payMethod === 'balance' || payMethod === 'mix') && item.balDiscounted}}">
          <text class="goods-subtotal-balance">¥{{item.balanceSubtotal}}</text>
          <text class="goods-subtotal-original">¥{{item.subtotal}}</text>
        </view>
        <view class="goods-subtotal-wrap" wx:elif="{{payMethod === 'wechat' && item.wxDiscounted}}">
          <text class="goods-subtotal-balance">¥{{item.wxSubtotal}}</text>
          <text class="goods-subtotal-original">¥{{item.subtotal}}</text>
        </view>
        <view class="goods-subtotal" wx:else>¥{{item.subtotal}}</view>
      </view>
      <van-empty wx:if="{{orderGoods.length === 0}}" description="购物车为空" />
    </view>
  </view>

  <!-- 优惠券区域 -->
  <view class="section">
    <view class="section-title">优惠券</view>
    <view class="coupon-row" bindtap="showCouponSelector">
      <view class="coupon-left">
        <text class="coupon-icon">[券]</text>
        <view class="coupon-info">
          <text wx:if="{{selectedCoupon}}" class="coupon-name">{{selectedCoupon.name}}</text>
          <text wx:else class="coupon-placeholder">暂无可用优惠券</text>
          <text wx:if="{{selectedCoupon && selectedCoupon.type === 'discount'}}" class="coupon-desc">
            {{selectedCoupon.discount * 10}}折
          </text>
          <text wx:if="{{selectedCoupon && selectedCoupon.type !== 'discount'}}" class="coupon-desc">
            满{{selectedCoupon.condition}}减{{selectedCoupon.value}}
          </text>
        </view>
      </view>
      <view class="coupon-right">
        <text wx:if="{{selectedCoupon}}" class="discount-amount" style="color: {{themeColor}};">-¥{{couponDiscount}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
    <view wx:if="{{selectedCoupon}}" class="cancel-coupon" bindtap="cancelCoupon">
      不使用优惠券
    </view>
  </view>

  <!-- 支付方式（只有余额支付和微信支付） -->
  <view class="section">
    <view class="section-title">支付方式</view>
    <view class="pay-method-list">
      <view class="pay-method-item {{payMethod === 'balance' ? 'active' : ''}} {{userBalance > 0 ? '' : 'disabled'}}"
        data-value="balance" bindtap="selectPayMethod"
        style="{{payMethod === 'balance' && userBalance > 0 ? 'border-color: ' + themeColor + '; background: ' + themeColor + '10;' : ''}}">
        <view class="pay-method-content">
          <view class="pay-method-left">
            <view class="pay-method-title-wrap">
              <text class="pay-method-title">余额支付</text>
            </view>
            <view class="pay-method-desc" wx:if="{{userBalance > 0}}">余额：¥{{priceHelper.formatBalance(userBalance)}}</view>
            <view class="pay-method-desc disabled" wx:else>余额为0，请先充值</view>
          </view>
          <view class="pay-method-radio {{payMethod === 'balance' ? 'checked' : ''}}"
            style="{{payMethod === 'balance' ? 'border-color: ' + themeColor : ''}}">
            <view class="radio-dot" wx:if="{{payMethod === 'balance'}}" style="background: {{themeColor}};"></view>
          </view>
        </view>
      </view>
      <!-- 余额为0时提示充值 -->
      <view class="recharge-tip" wx:if="{{userBalance <= 0}}" bindtap="goRecharge">
        <text>充值会员卡，余额便捷支付，点击</text>
        <text class="recharge-link">去充值 ></text>
      </view>
      <view class="pay-method-item {{payMethod === 'wechat' ? 'active' : ''}}"
        data-value="wechat" bindtap="selectPayMethod"
        style="{{payMethod === 'wechat' ? 'border-color: ' + themeColor + '; background: ' + themeColor + '10;' : ''}}">
        <view class="pay-method-content">
          <view class="pay-method-left">
            <view class="pay-method-title">微信支付</view>
          </view>
          <view class="pay-method-radio {{payMethod === 'wechat' ? 'checked' : ''}}"
            style="{{payMethod === 'wechat' ? 'border-color: ' + themeColor : ''}}">
            <view class="radio-dot" wx:if="{{payMethod === 'wechat'}}" style="background: {{themeColor}};"></view>
          </view>
        </view>
      </view>
    </view>
    <!-- 支付明细（仅当拆分支付时显示） -->
    <view class="payment-detail" wx:if="{{userBalance > 0 && (payMethod === 'mix' || (balancePayAmount > 0 && wechatPayAmount > 0))}}">
      <text class="detail-label">支付明细：</text>
      <view class="detail-items">
        <text wx:if="{{balancePayAmount > 0}}">余额支付 ¥{{priceHelper.formatBalance(balancePayAmount)}}</text>
        <text wx:if="{{wechatPayAmount > 0}}">微信支付 ¥{{priceHelper.formatBalance(wechatPayAmount)}}</text>
      </view>
    </view>
    <!-- 余额支付会员折扣优惠提示 -->
    <view class="balance-discount-info" wx:if="{{userBalance > 0 && (payMethod === 'balance' || payMethod === 'mix') && balanceDiscount > 0}}">
      <text wx:if="{{!hasSpecialDish}}" class="discount-info-text">会员卡余额支付享整单95折，已优惠 ¥{{priceHelper.formatBalance(balanceDiscount)}}</text>
      <text wx:else class="discount-info-text">会员卡余额支付折扣已按各菜品设置结算，共优惠 ¥{{priceHelper.formatBalance(balanceDiscount)}}</text>
    </view>
  </view>

  <!-- 时间段选择弹窗 -->
  <view class="modal-mask" wx:if="{{showTimeModal}}" catchtap="closeTimeModal">
    <view class="time-modal-dialog" catchtap="stopPropagation">
      <view class="time-modal-title">选择时间段</view>
      <scroll-view class="time-modal-content" scroll-y>
        <view class="time-option {{selectedTime === '立即' ? 'active' : ''}}" 
          data-time="立即" bindtap="selectTimeSlot"
          style="{{selectedTime === '立即' ? 'color: ' + themeColor + '; border-color: ' + themeColor + '; background: ' + themeColor + '10;' : ''}}">
          ⚡ 立即送出
        </view>
        <view class="time-option {{selectedTime === item ? 'active' : ''}}" wx:for="{{timeSlots}}" wx:key="*this"
          data-time="{{item}}" bindtap="selectTimeSlot"
          style="{{selectedTime === item ? 'color: ' + themeColor + '; border-color: ' + themeColor + '; background: ' + themeColor + '10;' : ''}}">
          {{item}}
        </view>
        <view wx:if="{{timeSlots.length === 0}}" style="text-align: center; padding: 40rpx; color: #999; font-size: 28rpx;">
          暂无自定义时段
        </view>
      </scroll-view>
      <view class="time-modal-footer">
        <view class="modal-btn cancel" bindtap="closeTimeModal">取消</view>
      </view>
    </view>
  </view>

  <!-- 底部提交 -->
  <view class="footer">
    <view class="footer-price-wrap">
      <!-- 余额支付时显示原价和折后价 -->
      <block wx:if="{{userBalance > 0 && (payMethod === 'balance' || payMethod === 'mix') && balanceDiscount > 0}}">
        <text class="footer-price-original">¥{{priceHelper.formatPrice(displayTotal + balanceDiscount)}}</text>
        <view class="footer-price">
          <text class="footer-label">实付：</text>
          <text class="footer-price-num" style="color: {{themeColor}};">¥{{priceHelper.formatPrice(displayTotal)}}</text>
        </view>
        <text wx:if="{{!hasSpecialDish}}" class="footer-discount-tip">会员卡95折省¥{{priceHelper.formatBalance(balanceDiscount)}}</text>
        <text wx:else class="footer-discount-tip">会员折扣省¥{{priceHelper.formatBalance(balanceDiscount)}}</text>
      </block>
      <view class="footer-price" wx:else>
        <text class="footer-label">实付：</text>
        <text class="footer-price-num" style="color: {{themeColor}};">¥{{priceHelper.formatPrice(displayTotal)}}</text>
      </view>
    </view>
    <view class="submit-btn {{submitting || !canSubmit ? 'disabled' : ''}}" bindtap="checkAndSubmit" style="background: {{submitting || !canSubmit ? '#ccc' : themeColor}};">
      <text wx:if="{{submitting}}">提交中...</text>
      <text wx:else>提交订单</text>
    </view>
  </view>

  <!-- 优惠券选择弹窗 -->
  <view class="modal-mask" wx:if="{{showCouponPicker}}" catchtap="closeCouponPicker">
    <view class="modal-dialog" catchtap="stopPropagation">
      <view class="modal-title">选择优惠券</view>
      <scroll-view class="coupon-list" scroll-y>
        <view wx:for="{{couponList}}" wx:key="_id" class="coupon-item" bindtap="selectCoupon" data-coupon="{{item}}" style="border-left-color: {{themeColor}};">
          <view class="coupon-item-left">
            <text class="coupon-item-name">{{item.name}}</text>
            <text wx:if="{{item.type === 'discount'}}" class="coupon-item-desc">{{item.discount * 10}}折</text>
            <text wx:else class="coupon-item-desc">满{{item.condition}}减{{item.value}}</text>
          </view>
          <view class="coupon-item-right">
            <text class="coupon-item-value" style="color: {{themeColor}};">{{item.displayValue}}</text>
            <view class="radio-btn"></view>
          </view>
        </view>
        <view wx:if="{{couponList.length === 0}}" class="empty-tip">暂无可用优惠券</view>
      </scroll-view>
      <view class="modal-footer">
        <view class="modal-btn cancel" bindtap="closeCouponPicker">关闭</view>
      </view>
    </view>
  </view>

  <!-- 用户授权组件 -->
  <avatar-nickname-modal showAvaModal="{{showAuthModal}}" bind:saved="onUserInfoSaved" />

  <!-- 结算成功抽奖弹窗 -->
  <view class="reward-popup-mask" wx:if="{{showRewardPopup}}" bindtap="closeRewardAndGoHome">
    <view class="reward-popup-container" catchtap="stopPropagation">
      <image class="reward-popup-image" src="{{rewardPopupImage}}" mode="widthFix"></image>
      <view class="reward-btns">
        <view class="reward-btn cancel" bindtap="closeRewardAndGoHome">取消</view>
        <view class="reward-btn confirm" bindtap="goToLotteryFromPopup">去抽奖</view>
      </view>
    </view>
  </view>
</view>