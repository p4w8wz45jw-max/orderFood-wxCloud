<!--components/avatarNicknameModal/avatarNicknameModal.wxml-->
<view class="page-mask" wx:if="{{showAvaModal}}" catchtouchmove="catchtouchmove" bindtap="closeModalTap">
  <view class="panel-box" catchtap="noop">
    <!-- 顶部装饰条 -->
    <view class="top-accent"></view>

    <!-- 标题栏 -->
    <view class="title-bar">
      <text class="title-text">完善个人信息</text>
      <image class="close-img" src="./image/close.png" mode="widthFix" bindtap="closeModalTap"></image>
    </view>

    <!-- 副标题 -->
    <text class="title-sub">授权后可享受更多会员服务</text>

    <!-- 头像区域 -->
    <view class="avatar-area">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="chooseavatar"></button>
      <view class="avatar-preview">
        <image wx:if="{{avatarUrl}}" class="avatar-img-real" src="{{avatarUrl}}" mode="scaleToFill"></image>
        <image wx:else class="avatar-img-default" src="./image/moren.png" mode="widthFix"></image>
      </view>
      <text class="avatar-hint">点击获取头像</text>
    </view>

    <!-- 表单区域 -->
    <view class="form-card">
      <!-- 昵称 -->
      <view class="form-row">
        <view class="form-row-left">
          <text class="form-label">昵称</text>
          <input class="form-input" placeholder="点击获取您的昵称" type="nickname" value="{{nickName}}" bindblur="bindblur" placeholder-style="color:#C0B0A0;"/>
        </view>
        <image class="arr-img" src="./image/arrow.png" mode="widthFix"></image>
      </view>

      <!-- 手机号 -->
      <view class="form-row last-row">
        <view class="form-row-left">
          <text class="form-label">手机号</text>
          <text class="form-phone-text">{{phoneNumber || '未获取'}}</text>
        </view>
        <button class="phone-btn" open-type="getPhoneNumber" bindgetphonenumber="getphonenumber">
          {{phoneNumber ? '已获取' : '获取'}}
        </button>
      </view>
    </view>

    <!-- 保存按钮 -->
    <view class="save-bar">
      <button class="save-btn" bindtap="saveUserInfo">保 存</button>
      <text class="skip-tip" bindtap="closeModalTap">暂不登录，先看看</text>
    </view>
  </view>
</view>
