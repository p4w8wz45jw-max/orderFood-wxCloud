/* pages/admin/user/user.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
  padding-bottom: 40rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  margin-bottom: 20rpx;
  gap: 15rpx;
}

.search-input {
  flex: 1;
  height: 70rpx;
  background: white;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.search-btn,
.clear-btn {
  padding: 0 30rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: white;
}

.search-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.clear-btn {
  background: #999;
}

/* 用户列表 */
.user-list {
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
}

.user-item {
  padding: 30rpx;
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #f5f5f5;
}

.user-item:last-child {
  border-bottom: none;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.default-avatar {
  width: 100%;
  height: 100%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
}

.member-badge {
  font-size: 28rpx;
  margin-left: 10rpx;
}

.user-detail {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 5rpx;
}

.user-detail:last-child {
  margin-bottom: 0;
}

/* 详情行布局 */
.user-detail-row {
  display: flex;
  align-items: center;
}

/* 详情emoji图标 */
.detail-emoji {
  font-size: 28rpx;
  margin-right: 6rpx;
  flex-shrink: 0;
}

.user-arrow {
  font-size: 28rpx;
  color: #999;
}

.user-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-left: 20rpx;
}

.action-btn {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  white-space: nowrap;
  text-align: center;
}

.balance-btn {
  background: #667eea;
  color: white;
}

.points-btn {
  background: #e6a23c;
  color: white;
}

.coupon-btn {
  background: #67c23a;
  color: white;
}

.view-coupon-btn {
  background: #909399;
  color: white;
}

.view-order-btn {
  background: #409eff;
  color: white;
}

/* 余额可点击 */
.balance-clickable {
  cursor: pointer;
  padding: 8rpx 0;
}

/* 手机号可点击 */
.phone-clickable {
  cursor: pointer;
  padding: 8rpx 0;
}

.balance-arrow {
  font-size: 32rpx;
  color: #999;
  margin-left: 10rpx;
  font-weight: bold;
}

/* 余额明细弹窗 */
.balance-detail-dialog {
  width: 640rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.balance-total {
  font-size: 26rpx;
  color: #666;
  margin-top: 10rpx;
  font-weight: normal;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  line-height: 1.5;
}

.balance-total-num {
  font-size: 30rpx;
  color: #667eea;
  font-weight: bold;
  margin: 0 4rpx;
}

.balance-detail-content {
  flex: 1;
  max-height: 500rpx;
  padding: 0 30rpx 20rpx;
}

/* 积分明细弹窗 */
.points-detail-dialog {
  width: 640rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.points-total-num {
  color: #e6a23c;
}

/* 历史订单弹窗 */
.orders-dialog {
  width: 640rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.orders-content {
  flex: 1;
  min-height: 0;
  max-height: 55vh;
  padding: 0 30rpx 20rpx;
}

.orders-list {
  padding-top: 10rpx;
}

.order-item {
  position: relative;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx 50rpx 20rpx 20rpx;
  margin-bottom: 16rpx;
}

.order-item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.order-item-type {
  font-size: 24rpx;
  color: #409eff;
  background: rgba(64, 158, 255, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.order-item-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.order-item-status.paid {
  background: #e8f5e9;
  color: #67c23a;
}

.order-item-status.unpaid {
  background: #fdf6ec;
  color: #e6a23c;
}

.order-item-goods {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 10rpx;
  line-height: 1.5;
}

.order-item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-item-time {
  font-size: 22rpx;
  color: #999;
}

.order-item-price {
  font-size: 28rpx;
  color: #e54d42;
  font-weight: bold;
}

.order-item-arrow {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: #ccc;
}

/* 优惠券明细弹窗 */
.coupons-dialog {
  width: 640rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.coupon-filter-tabs {
  display: flex;
  gap: 12rpx;
  padding: 0 30rpx 16rpx;
}

.coupon-filter-tab {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 24rpx;
  padding: 10rpx 0;
}

.coupon-filter-tab.active {
  background: #667eea;
  color: #fff;
  font-weight: bold;
}

.coupons-content {
  flex: 1;
  max-height: 600rpx;
  padding: 0 30rpx 20rpx;
}

.coupons-list {
  padding-top: 10rpx;
}

.coupon-item {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.coupon-item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.coupon-item-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  flex: 1;
  margin-right: 12rpx;
}

.coupon-item-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.coupon-item-status.unused {
  background: #e8f5e9;
  color: #67c23a;
}

.coupon-item-status.used {
  background: #e5e5e5;
  color: #999;
}

.coupon-item-status.expired {
  background: #fce4ec;
  color: #e54d42;
}

.coupon-item-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.coupon-item-type {
  font-size: 22rpx;
  color: #667eea;
}

.coupon-item-source {
  font-size: 22rpx;
  color: #e6a23c;
}

.coupon-item-time {
  font-size: 22rpx;
  color: #999;
}

.coupon-item-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #e5e5e5;
}

.coupon-item-delete {
  font-size: 24rpx;
  color: #e54d42;
  background: #fce4ec;
  border-radius: 24rpx;
  padding: 8rpx 26rpx;
}

.balance-loading,
.balance-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

.balance-list {
  padding-top: 10rpx;
}

.balance-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.balance-item:last-child {
  border-bottom: none;
}

.balance-item-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.balance-item-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.income-icon {
  background: #e8f5e9;
}

.expense-icon {
  background: #fce4ec;
}

.balance-item-info {
  flex: 1;
}

.balance-item-desc {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.balance-item-date {
  font-size: 22rpx;
  color: #999;
}

.balance-item-amount {
  font-size: 30rpx;
  font-weight: bold;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.balance-item-amount.income {
  color: #67c23a;
}

.balance-item-amount.expense {
  color: #e54d42;
}

.empty-tip {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-dialog {
  width: 600rpx;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-title {
  padding: 40rpx 30rpx 20rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.modal-content {
  padding: 20rpx 30rpx 40rpx;
}

.user-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.preview-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.preview-avatar image {
  width: 100%;
  height: 100%;
}

.preview-name {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.preview-current {
  font-size: 26rpx;
  color: #e6a23c;
  margin-top: 8rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 优惠券选择器 */
.picker-display {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  color: #333;
}

.picker-display.disabled {
  color: #999;
  background: #f9f9f9;
}

.picker-arrow {
  font-size: 22rpx;
  color: #999;
  margin-left: 10rpx;
}

/* 优惠券预览卡片 */
.coupon-preview {
  margin-top: 20rpx;
}

.coupon-preview-card {
  background: linear-gradient(135deg, #ff9a56 0%, #ff6b6b 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  color: white;
}

.coupon-preview-type {
  font-size: 24rpx;
  opacity: 0.85;
  margin-bottom: 10rpx;
}

.coupon-preview-value {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.coupon-preview-expire {
  font-size: 22rpx;
  opacity: 0.8;
}

.balance-edit {
  display: flex;
  gap: 15rpx;
}

.balance-edit .form-input {
  flex: 1;
}

.recharge-btn {
  padding: 0 30rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #67c23a;
  color: white;
  border-radius: 10rpx;
  font-size: 26rpx;
  white-space: nowrap;
}

.modal-footer {
  display: flex;
  border-top: 2rpx solid #e5e5e5;
}

.modal-btn {
  flex: 1;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.modal-btn.cancel {
  color: #999;
  border-right: 2rpx solid #e5e5e5;
}

.modal-btn.confirm {
  color: #667eea;
  font-weight: bold;
}

