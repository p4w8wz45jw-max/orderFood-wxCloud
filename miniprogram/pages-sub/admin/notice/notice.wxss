/* pages-sub/admin/notice/notice.wxss */
.page {
  background: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.section {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #eee;
}

/* 充值说明输入框 */
.recharge-input {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.save-btn {
  background: #07c160;
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 16rpx;
}

