/* pages/myhome/myhome.wxss - 温暖奶油风 */
.page {
  min-height: 100vh;
  background: #F5EDE4;
  padding-bottom: 40rpx;
}

/* ====== 用户信息头部 ====== */
.user-info-header {
  margin: 30rpx 32rpx 20rpx;
  background: #FFFBF7;
  border-radius: 20rpx;
  padding: 30rpx 28rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(139, 115, 85, 0.06);
  border: 1rpx solid rgba(160, 128, 96, 0.08);
}
.user-avatar-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.user-avatar {
  width: 100%;
  height: 100%;
}
.user-avatar-placeholder {
  width: 100%;
  height: 100%;
  background: #F0E8DC;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.avatar-default-icon {
  width: 56rpx;
  height: 56rpx;
}
.user-name-box {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.user-name {
  font-size: 32rpx;
  color: #5C4A3A;
  font-weight: bold;
  margin-bottom: 6rpx;
}
.user-hint {
  font-size: 24rpx;
  color: #A09888;
}
.user-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
}
.arrow-icon {
  font-size: 40rpx;
  color: #B0A090;
  font-weight: bold;
}

/* ====== VIP会员储值卡片 ====== */
.vip-card {
  margin: 0 32rpx 24rpx;
  background: #FFFBF7;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  box-shadow: 0 4rpx 16rpx rgba(139, 115, 85, 0.06);
  border: 1rpx solid rgba(160, 128, 96, 0.08);
}
.vip-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.vip-title-row { margin-bottom: 6rpx; }
.vip-title {
  font-size: 32rpx;
  color: #5C4A3A;
  font-weight: bold;
}
.vip-subtitle {
  font-size: 22rpx;
  color: #A09888;
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}
.recharge-btn {
  display: inline-flex;
  align-items: center;
  background: #F0E0C8;
  padding: 14rpx 28rpx;
  border-radius: 30rpx;
  width: fit-content;
}
.recharge-btn-text {
  font-size: 26rpx;
  color: #5C4A3A;
  font-weight: bold;
}
.vip-right {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}
.vip-badge {
  width: 220rpx;
  height: 140rpx;
  border: 3rpx solid #D4B896;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FAF6F0;
  position: relative;
  padding: 12rpx 16rpx;
}
.vip-text {
  font-size: 36rpx;
  color: #C4A882;
  font-weight: bold;
  position: absolute;
  top: 12rpx;
  left: 18rpx;
  letter-spacing: 2rpx;
}
.vip-avatar-small {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.vip-avatar-emoji {
  width: 48rpx;
  height: 48rpx;
}
.vip-name {
  font-size: 20rpx;
  color: #B0A090;
  margin-top: 6rpx;
}

/* ====== 余额快捷查看 ====== */
.quick-info-card {
  margin: 0 32rpx 24rpx;
  background: #FFFBF7;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  display: flex;
  box-shadow: 0 4rpx 16rpx rgba(139, 115, 85, 0.06);
  border: 1rpx solid rgba(160, 128, 96, 0.08);
}
.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.quick-label {
  font-size: 24rpx;
  color: #A09888;
  margin-bottom: 8rpx;
}
.quick-value {
  font-size: 36rpx;
  color: #5C4A3A;
  font-weight: bold;
}
.quick-value.highlight { color: #C49A6C; }
.quick-divider {
  width: 1rpx;
  background: rgba(160, 128, 96, 0.18);
  margin: 0 20rpx;
}

/* ====== 功能网格 ====== */
.func-grid {
  margin: 0 32rpx 24rpx;
  background: #FFFBF7;
  border-radius: 20rpx;
  padding: 30rpx 16rpx;
  display: flex;
  flex-wrap: wrap;
  box-shadow: 0 4rpx 16rpx rgba(139, 115, 85, 0.06);
  border: 1rpx solid rgba(160, 128, 96, 0.08);
}
.func-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}
.func-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}
.func-text {
  font-size: 24rpx;
  color: #5C4A3A;
  text-align: center;
}

/* ====== 公告 ====== */
.notice-card {
  margin: 0 32rpx 20rpx;
  background: #FFFBF7;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(160, 128, 96, 0.08);
}

/* ====== 管理员入口 ====== */
.admin-trigger {
  height: 20rpx;
  width: 100%;
}
.admin-hidden-btn {
  position: fixed;
  bottom: 100rpx;
  right: 20rpx;
  width: 70rpx;
  height: 70rpx;
  background: rgba(184, 149, 110, 0.15);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #8B7355;
  z-index: 999;
}

/* ====== 弹窗样式 ====== */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(92, 74, 58, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}
.modal-dialog {
  width: 600rpx;
  background: #FFFBF7;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(160, 128, 96, 0.10);
}
.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  padding: 36rpx 30rpx 20rpx;
  color: #5C4A3A;
  border-bottom: 1rpx solid rgba(160, 128, 96, 0.08);
}
.modal-content { padding: 30rpx; }
.password-input {
  width: 100%; height: 84rpx;
  border: 2rpx solid #E0D4C4;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  background: #FFFBF7;
  color: #5C4A3A;
}
.password-hint {
  font-size: 24rpx;
  color: #A09888;
  text-align: center;
}
.modal-footer {
  display: flex;
  border-top: 1rpx solid rgba(160, 128, 96, 0.08);
}
.modal-btn {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}
.modal-btn.cancel {
  color: #A09888;
  border-right: 1rpx solid rgba(160, 128, 96, 0.08);
}
.modal-btn.confirm { font-weight: bold; color: #B8956E; }

/* ====== 余额明细弹窗 ====== */
.balance-detail-dialog {
  width: 640rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.balance-total {
  font-size: 26rpx;
  color: #8b7355;
  margin-top: 10rpx;
  font-weight: normal;
}

.balance-total-num {
  font-size: 32rpx;
  color: #B8956E;
  font-weight: bold;
}

.balance-detail-content {
  flex: 1;
  max-height: 500rpx;
  padding: 0 30rpx 20rpx;
}

.balance-loading,
.balance-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #A09888;
}

.balance-list {
  padding-top: 10rpx;
}

.balance-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid rgba(160, 128, 96, 0.08);
}

.balance-item:last-child {
  border-bottom: none;
}

.balance-item-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.balance-item-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.income-icon {
  background: #e8f5e9;
}

.expense-icon {
  background: #fce4ec;
}

.balance-item-info {
  flex: 1;
}

.balance-item-desc {
  font-size: 28rpx;
  color: #5c4a3a;
  margin-bottom: 6rpx;
}

.balance-item-date {
  font-size: 22rpx;
  color: #A09888;
}

.balance-item-amount {
  font-size: 30rpx;
  font-weight: bold;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.balance-item-amount.income {
  color: #67c23a;
}

.balance-item-amount.expense {
  color: #e54d42;
}

/* ====== 联系客服弹窗 ====== */
.service-dialog {
  width: 80vw;
  max-height: 80vh;
  background: #fdf8ef;
  border-radius: 24rpx;
  overflow: hidden;
}

.service-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 40rpx 40rpx;
}

.service-qrcode-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.service-qrcode {
  width: 360rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(180, 155, 120, 0.15);
}

.service-qrcode-tip {
  font-size: 24rpx;
  color: #8b7355;
  margin-top: 16rpx;
}

.service-qrcode-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  margin-bottom: 20rpx;
}

.service-qrcode-empty .empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.service-qrcode-empty .empty-text {
  font-size: 26rpx;
  color: #a08060;
}

.service-phone-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 40rpx;
  background: #f5edd8;
  border-radius: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.service-phone-label {
  font-size: 24rpx;
  color: #8b7355;
  margin-bottom: 10rpx;
}

.service-phone-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #c07840;
  letter-spacing: 4rpx;
}

.service-phone-tip {
  font-size: 22rpx;
  color: #a08060;
  margin-top: 10rpx;
}

/* ====== 版本信息 ====== */
.version-info {
  text-align: center;
  padding: 10rpx 0 30rpx;
}
.version-text {
  font-size: 22rpx;
  color: #B0A090;
}
