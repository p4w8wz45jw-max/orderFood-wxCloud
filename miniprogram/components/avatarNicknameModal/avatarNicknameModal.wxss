/* ========================================
   components/avatarNicknameModal 优化样式
   精致的底部弹出登录面板
   ======================================== */

/* ---- 遮罩 ---- */
.page-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.50);
  z-index: 1999;
  display: flex;
  align-items: flex-end;
  animation: maskIn 0.25s ease;
}
@keyframes maskIn {
  from { background: rgba(0, 0, 0, 0); }
  to   { background: rgba(0, 0, 0, 0.50); }
}

/* ---- 面板容器 ---- */
.panel-box {
  width: 100vw;
  max-height: 88vh;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  animation: panelUp 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes panelUp {
  from { transform: translateY(100%); opacity: 0; }
  to   { transform: translateY(0);    opacity: 1; }
}

/* ---- 顶部装饰 ---- */
.top-accent {
  height: 6rpx;
  width: 100%;
  background: linear-gradient(90deg, #B8956E 0%, #D4B896 40%, #C49A6C 100%);
  flex-shrink: 0;
}

/* ---- 标题栏 ---- */
.title-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 36rpx 40rpx 10rpx;
  flex-shrink: 0;
}
.title-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
}
.close-img {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  height: 48rpx;
  width: 48rpx;
  padding: 8rpx;
  border-radius: 50%;
  background: #F2F2F2;
}
.title-sub {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #B8956E;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

/* ---- 头像 ---- */
.avatar-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  width: 220rpx;
  margin: 0 auto 18rpx;
  flex-shrink: 0;
}
.avatar-btn {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  width: 100% !important;
  height: 100% !important;
  background: transparent;
  z-index: 9;
  opacity: 0.01;
}
.avatar-preview {
  width: 180rpx;
  height: 180rpx;
  border-radius: 24rpx;
  background: #F8F4EE;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(139, 115, 85, 0.08);
}
.avatar-img-real {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}
.avatar-img-default {
  width: 100rpx;
  height: 100rpx;
  opacity: 0.5;
}
.avatar-hint {
  font-size: 24rpx;
  color: #A09888;
  margin-top: 16rpx;
}

/* ---- 表单卡片 ---- */
.form-card {
  margin: 8rpx 32rpx;
  background: #FFFDF8;
  border-radius: 20rpx;
  border: 1rpx solid #F0EBE3;
  overflow: hidden;
  flex-shrink: 0;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  min-height: 104rpx;
  border-bottom: 1rpx solid #F0EBE3;
}
.form-row.last-row {
  border-bottom: none;
}

.form-row-left {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  width: 140rpx;
  flex-shrink: 0;
  font-weight: 500;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  height: 104rpx;
  line-height: 104rpx;
}

.form-phone-text {
  font-size: 28rpx;
  color: #B0A090;
}

.arr-img {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  opacity: 0.5;
}

/* ---- 手机号按钮 ---- */
.phone-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%);
  border-radius: 28rpx;
  padding: 12rpx 26rpx;
  line-height: 1;
  border: none;
  font-weight: 500;
  box-shadow: 0 4rpx 14rpx rgba(124, 58, 237, 0.25);
  width: auto !important;
}
.phone-btn::after { border: none; }
.phone-btn:active {
  opacity: 0.85;
  transform: scale(0.96);
}

/* ---- 底部按钮 ---- */
.save-bar {
  padding: 30rpx 60rpx 40rpx;
  flex-shrink: 0;
}

.save-btn {
  width: 100%;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #C4956A 0%, #B8860B 100%);
  color: #FFFFFF;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  text-indent: 8rpx;
  border: none;
  box-shadow: 0 6rpx 22rpx rgba(196, 149, 106, 0.35);
  padding: 0;
}
.save-btn::after { border: none; }
.save-btn:active {
  opacity: 0.88;
  transform: scale(0.98);
}

/* ---- 跳过 ---- */
.skip-tip {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #C4B5A0;
  margin-top: 22rpx;
}
