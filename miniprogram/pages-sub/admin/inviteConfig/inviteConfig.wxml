<!--pages-sub/admin/inviteConfig/inviteConfig.wxml-->
<view class="page">
  <view class="form-section">
    <!-- 开启邀请有奖 -->
    <view class="form-item">
      <view class="form-label">邀请有奖开关</view>
      <view class="rule-row">
        <text>开启邀请有奖活动</text>
        <switch checked="{{inviteEnabled}}" bindchange="onInviteEnabledChange" color="{{themeColor}}" />
      </view>
      <view class="tip" wx:if="{{!inviteEnabled}}" style="color: #e54d42;">当前未开启邀请有奖活动</view>
      <view class="tip" wx:if="{{inviteEnabled}}" style="color: #07c160;">已开启邀请有奖活动</view>
    </view>

    <!-- 活动描述 -->
    <view class="form-item">
      <view class="form-label">活动描述</view>
      <textarea class="desc-input" placeholder="如：邀请好友下单，双方各得一张优惠券！" maxlength="100" value="{{inviteDesc}}" bindinput="onInviteDescInput" auto-height />
      <view class="tip">将显示在邀请页面中</view>
    </view>

    <!-- 选择奖励优惠券 -->
    <view class="form-item">
      <view class="form-label">奖励优惠券</view>
      <picker mode="selector" range="{{couponList}}" range-key="name" value="{{couponIndex}}" bindchange="onCouponChange">
        <view class="picker-display">
          <text wx:if="{{selectedCoupon}}">{{selectedCoupon.name}}（{{selectedCoupon.type === 'full_reduction' ? '满' + selectedCoupon.condition + '减' + selectedCoupon.value : selectedCoupon.type === 'discount' ? selectedCoupon.discount + '折' : '商品券'}}）</text>
          <text wx:else style="color: #999;">请选择优惠券</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
      <view class="tip" wx:if="{{!selectedCoupon}}">请先在优惠券管理中创建优惠券模板</view>
      <view class="tip" wx:if="{{selectedCoupon}}">新用户通过邀请卡下单成功后，将自动获得此优惠券</view>
    </view>

    <button class="save-btn" type="primary" bindtap="saveConfig">保存配置</button>
  </view>
</view>
