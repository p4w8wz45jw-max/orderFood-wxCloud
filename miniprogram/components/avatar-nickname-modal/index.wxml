<!-- 精致现代登录弹窗 -->
<view class="modal-root {{showAvaModal ? 'visible' : ''}}" wx:if="{{showAvaModal}}" catchtap="closeModal">
  <view class="modal-card" catchtap="noop">
    <!-- 顶部装饰条 -->
    <view class="top-accent"></view>

    <!-- 关闭按钮 -->
    <view class="close-btn" bindtap="closeModal">
      <view class="close-icon-wrap">
        <text class="close-icon">✕</text>
      </view>
    </view>

    <!-- 头部 -->
    <view class="modal-header">
      <text class="modal-title">完善个人信息</text>
      <text class="modal-desc">授权后可享受更多会员服务</text>
    </view>

    <!-- 头像区域 -->
    <view class="avatar-section">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <view class="avatar-frame">
          <view class="avatar-ring">
            <image class="avatar-img" src="{{avatarUrl || '/images/tabBar/me.png'}}" mode="aspectFill"></image>
          </view>
          <view class="camera-dot">
            <text class="camera-emoji">📷</text>
          </view>
        </view>
      </button>
      <text class="avatar-tip">点击设置头像</text>
    </view>

    <!-- 表单 -->
    <view class="form-section">
      <!-- 昵称 -->
      <view class="form-item">
        <view class="form-icon nick-icon">
          <text class="icon-text">✎</text>
        </view>
        <view class="form-body">
          <text class="form-label">昵称</text>
          <input class="form-input" type="nickname" placeholder="点击获取微信昵称" value="{{nickName}}" bindinput="onNicknameInput" placeholder-style="color:#C4B5A0;"/>
        </view>
        <text class="form-arrow">›</text>
      </view>

      <!-- 手机号 -->
      <view class="form-item">
        <view class="form-icon phone-icon">
          <text class="icon-text">📱</text>
        </view>
        <view class="form-body">
          <text class="form-label">手机号</text>
          <text class="form-value">{{phoneNumber || '未获取'}}</text>
        </view>
        <button class="phone-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">
          {{phoneNumber ? '已获取' : '获取'}}
        </button>
      </view>
    </view>

    <!-- 底部按钮 -->
    <view class="footer-area">
      <button class="submit-btn" bindtap="saveInfo">保 存</button>
      <text class="skip-text" bindtap="closeModal">暂不登录，先看看</text>
    </view>
  </view>
</view>
