/* pages/admin/pageLayout/pageLayout.wxss */
.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}
.section-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  border-left: 8rpx solid #07c160;
  padding-left: 20rpx;
}
.bg-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.preview-img {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  background: #f0f0f0;
}
.btn-group {
  display: flex;
  gap: 20rpx;
}
.empty-bg {
  text-align: center;
  padding: 40rpx;
  color: #999;
}
.save-btn {
  margin-top: 40rpx;
  background-color: #07c160;
  color: #fff;
  border-radius: 50rpx;
}
/* 在原有样式基础上增加以下内容 */
.image-upload {
  width: 200rpx;
  height: 200rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1rpx dashed #ddd;
  margin-bottom: 10rpx;
}
.image-upload image {
  width: 100%;
  height: 100%;
}
.upload-placeholder {
  font-size: 50rpx;
  color: #ccc;
}
.remove-btn {
  font-size: 24rpx;
  color: #ff6b6b;
  margin-top: 5rpx;
}
.tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}
/* 轮播广告图管理 */
.carousel-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.carousel-item {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #e5e5e5;
}
.carousel-preview {
  width: 100%;
  height: 100%;
}
.carousel-delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 16rpx 0 16rpx;
  font-size: 24rpx;
}
.carousel-add {
  width: 200rpx;
  height: 200rpx;
  background: #f5f5f5;
  border: 1rpx dashed #ddd;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.add-placeholder {
  font-size: 28rpx;
  color: #999;
}