/* pages/diy/diy.wxss - 温暖奶油风 */
.page {
  min-height: 100vh;
  background: #F5EDE4;
  padding-bottom: 60rpx;
}

/* 顶部横幅 */
.banner {
  margin: 20rpx;
  padding: 50rpx 40rpx;
  background: linear-gradient(135deg, #B8956E, #D8BC96);
  border-radius: 20rpx;
  color: #fff;
}

.banner-title {
  font-size: 44rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.banner-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

/* 空态提示 */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #8B7355;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
}

/* 套餐卡片 */
.menu-cards {
  margin: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.menu-card {
  display: flex;
  align-items: center;
  background: #FFFBF7;
  border-radius: 20rpx;
  padding: 36rpx 30rpx;
  border: 1rpx solid rgba(160, 128, 96, 0.08);
  box-shadow: 0 4rpx 16rpx rgba(139, 115, 85, 0.06);
}

.menu-card:active {
  transform: scale(0.98);
  background: #FBF3EB;
}

.card-icon {
  font-size: 72rpx;
  margin-right: 24rpx;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.card-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #5C4A3A;
}

.card-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8B7355;
}

.card-price {
  display: flex;
  align-items: baseline;
}

.price-prefix {
  font-size: 26rpx;
  color: #B8956E;
  font-weight: bold;
}

.price-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #B8956E;
}

.price-tip {
  font-size: 22rpx;
  color: #8B7355;
  margin-left: 6rpx;
}

.card-arrow {
  margin-left: 14rpx;
  font-size: 40rpx;
  color: #D4C4AC;
}

/* 选择弹层 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(92, 74, 58, 0.55);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.selector-panel {
  width: 100%;
  background: #FFFBF7;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  max-height: 80vh;
}

.selector-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid rgba(160, 128, 96, 0.10);
}

.selector-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5C4A3A;
}

.selector-close {
  font-size: 36rpx;
  color: #8B7355;
  padding: 0 10rpx;
}

.selector-body {
  flex: 1;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
  max-height: 55vh;
}

.option-group {
  margin-bottom: 24rpx;
}

.option-group-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #5C4A3A;
  margin-bottom: 14rpx;
}

.option-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.option-item {
  position: relative;
  width: calc((100% - 28rpx) / 3);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 6rpx;
  background: #FAF6F1;
  border: 2rpx solid #E8DDD0;
  border-radius: 12rpx;
}

.option-item.selected {
  background: #F3E5D1;
  border-color: #B8956E;
  border-width: 3rpx;
  box-shadow: 0 4rpx 12rpx rgba(184, 149, 110, 0.3);
}

.option-check {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  font-size: 18rpx;
  font-weight: bold;
  color: #fff;
  background: #B8956E;
  border-radius: 50%;
  box-shadow: 0 2rpx 6rpx rgba(184, 149, 110, 0.4);
}

.option-name {
  font-size: 24rpx;
  color: #5C4A3A;
  margin-bottom: 4rpx;
}

.option-item.selected .option-name {
  font-weight: bold;
  color: #B8956E;
}

.option-extra {
  display: flex;
  align-items: baseline;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #e54d42;
  background: #FFF0EC;
  border: 1rpx solid #F5CFC4;
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
}

.option-extra-prefix {
  font-size: 18rpx;
}

.option-extra-num {
  font-size: 22rpx;
  font-weight: bold;
}

.option-item.selected .option-extra {
  background: #F3E5D1;
  border-color: #B8956E;
  color: #B8956E;
}

.option-price {
  font-size: 24rpx;
  color: #8B7355;
}

.option-item.selected .option-price {
  color: #B8956E;
  font-weight: bold;
}

/* 底部结算栏 */
.selector-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(160, 128, 96, 0.10);
  background: #FFFBF7;
}

.footer-total {
  display: flex;
  align-items: baseline;
}

.total-info {
  display: flex;
  flex-direction: column;
  margin-right: 12rpx;
}

.total-label {
  font-size: 26rpx;
  color: #5C4A3A;
}

.total-extra {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #e54d42;
}

.total-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #e54d42;
}

.confirm-btn {
  min-width: 200rpx;
  text-align: center;
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  padding: 20rpx 50rpx;
  border-radius: 44rpx;
}

/* 提建议入口 */
.suggest-entry {
  margin: 20rpx;
  display: flex;
  align-items: center;
  background: #FFFBF7;
  border: 1rpx dashed #D8BC96;
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
}

.suggest-entry:active {
  background: #FBF3EB;
}

.suggest-entry-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.suggest-entry-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.suggest-entry-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #5C4A3A;
}

.suggest-entry-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8B7355;
}

.suggest-entry-arrow {
  font-size: 40rpx;
  color: #D4C4AC;
}

/* 提建议弹层 */
.suggest-panel {
  width: 100%;
  background: #FFFBF7;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.suggest-body {
  padding: 24rpx 30rpx;
}

.suggest-textarea {
  width: 100%;
  height: 240rpx;
  box-sizing: border-box;
  background: #FAF6F1;
  border: 2rpx solid #E8DDD0;
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #5C4A3A;
  line-height: 1.6;
}

.suggest-count {
  margin-top: 10rpx;
  text-align: right;
  font-size: 22rpx;
  color: #B5A48F;
}

.suggest-footer {
  padding: 0 30rpx;
}

.suggest-submit {
  width: 100%;
  box-sizing: border-box;
  min-width: 0;
}

/* 一周菜单 */
.week-section {
  margin: 20rpx;
  background: #FFFBF7;
  border-radius: 20rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(160, 128, 96, 0.08);
  box-shadow: 0 4rpx 16rpx rgba(139, 115, 85, 0.06);
}

.week-header {
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.week-header:active {
  opacity: 0.6;
}

.week-header-left {
  flex: 1;
  min-width: 0;
}

.week-toggle {
  flex-shrink: 0;
  margin-left: 20rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #8B7355;
  background: #F3EBDF;
  border: 1rpx solid #E8DDD0;
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
}

.week-arrow {
  margin-left: 6rpx;
  font-size: 20rpx;
  transition: transform 0.2s;
}

.week-arrow.expanded {
  transform: rotate(180deg);
}

.week-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5C4A3A;
}

.week-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8B7355;
}

.week-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.week-card {
  width: calc((100% - 20rpx) / 2);
  box-sizing: border-box;
  background: #FAF6F1;
  border: 2rpx solid #E8DDD0;
  border-radius: 14rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  min-height: 180rpx;
}

.week-card.filled {
  border-color: #B8956E;
  background: #FBF3EB;
}

.week-card:active {
  transform: scale(0.98);
}

.week-day-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #5C4A3A;
  margin-bottom: 10rpx;
}

.week-card-content {
  flex: 1;
}

.week-card-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #B8956E;
}

.week-card-combo {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8B7355;
  line-height: 1.4;
  word-break: break-all;
}

.week-card-bottom {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.week-card-price {
  font-size: 28rpx;
  font-weight: bold;
  color: #e54d42;
}

.week-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.week-pay {
  font-size: 22rpx;
  color: #fff;
  background: #B8956E;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
}

.week-pay:active {
  opacity: 0.8;
}

.week-edit {
  font-size: 22rpx;
  color: #8B7355;
  border: 1rpx solid #D8BC96;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  background: #FFFBF7;
}

.week-card-empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  color: #B5A48F;
}

.week-add-icon {
  font-size: 44rpx;
  line-height: 1;
}

.week-add-text {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.week-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999;
}
