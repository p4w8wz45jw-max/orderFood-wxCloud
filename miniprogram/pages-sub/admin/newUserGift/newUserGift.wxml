<!--pages-sub/admin/newUserGift/newUserGift.wxml-->
<view class="page">
  <view class="form-section">
    <!-- 开启新用户赠礼 -->
    <view class="form-item">
      <view class="form-label">新用户赠礼开关</view>
      <view class="rule-row">
        <text>开启新用户赠礼活动</text>
        <switch checked="{{giftEnabled}}" bindchange="onGiftEnabledChange" color="{{themeColor}}" />
      </view>
      <view class="tip" wx:if="{{!giftEnabled}}" style="color: #e54d42;">当前未开启新用户赠礼</view>
      <view class="tip" wx:if="{{giftEnabled}}" style="color: #07c160;">已开启新用户赠礼</view>
    </view>

    <!-- 选择赠品优惠券 -->
    <view class="form-item">
      <view class="form-label">赠品优惠券</view>
      <picker mode="selector" range="{{couponList}}" range-key="name" value="{{couponIndex}}" bindchange="onCouponChange">
        <view class="picker-display">
          <text wx:if="{{selectedCoupon}}">{{selectedCoupon.name}}（{{selectedCoupon.type === 'full_reduction' ? '满' + selectedCoupon.condition + '减' + selectedCoupon.value : selectedCoupon.type === 'discount' ? selectedCoupon.discount + '折' : '商品券：' + selectedCoupon.productName}}）</text>
          <text wx:else style="color: #999;">请选择优惠券</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
      <view class="tip" wx:if="{{!selectedCoupon}}">请先在优惠券管理中创建优惠券模板</view>
      <view class="tip" wx:if="{{selectedCoupon}}">新用户首次登录后，将自动获得此优惠券</view>
    </view>

    <button class="save-btn" type="primary" bindtap="saveConfig" style="background-color: {{themeColor}};">保存配置</button>
  </view>
</view>
