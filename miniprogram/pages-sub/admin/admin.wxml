<!--pages-sub/admin/admin.wxml-->
<view class="page">
  <!-- 数据管理 -->
  <view class="menu-section">
    <view class="section-title">数据管理</view>
    <view class="grid">
      <view class="grid-item" bindtap="goToDish">
        <text class="icon">🍽️</text>
        <text class="text">菜品管理</text>
      </view>
      <view class="grid-item" bindtap="goToUser">
        <text class="icon">👥</text>
        <text class="text">会员管理</text>
      </view>
      <view class="grid-item" bindtap="goToOrder">
        <text class="icon">📋</text>
        <text class="text">订单管理</text>
      </view>
      <view class="grid-item" bindtap="goToRechargeOptions">
        <text class="icon">💰</text>
        <text class="text">充值选项</text>
      </view>

      <view class="grid-item" bindtap="goToPageLayout">
        <text class="icon">🎨</text>
        <text class="text">页面布置</text>
      </view>
      <view class="grid-item" bindtap="goToLotteryConfig">
        <text class="icon">🎁</text>
        <text class="text">抽奖配置</text>
      </view>
      <view class="grid-item" bindtap="goToCouponManage">
        <text class="icon">🎫</text>
        <text class="text">优惠券管理</text>
      </view>
      <!-- 新增：积分商城配置 -->
      <view class="grid-item" bindtap="goToPointsConfig">
        <text class="icon">⭐</text>
        <text class="text">积分商城配置</text>
      </view>
      <!-- 秒杀活动管理 -->
      <view class="grid-item" bindtap="goToSeckill">
        <text class="icon">⚡</text>
        <text class="text">秒杀管理</text>
      </view>
      <!-- 新增：新用户赠礼 -->
      <view class="grid-item" bindtap="goToNewUserGift">
        <text class="icon">🎁</text>
        <text class="text">新用户赠礼</text>
      </view>
      <!-- 新增：数据统计 -->
      <view class="grid-item" bindtap="goToStatistics">
        <text class="icon">📊</text>
        <text class="text">数据统计</text>
      </view>
      <!-- 新增：邀请有奖配置 -->
      <view class="grid-item" bindtap="goToInviteConfig">
        <text class="icon">✉️</text>
        <text class="text">邀请有奖</text>
      </view>
      <!-- 新增：DIY菜单配置 -->
      <view class="grid-item" bindtap="goToDiyConfig">
        <text class="icon">🍱</text>
        <text class="text">DIY菜单配置</text>
      </view>
    </view>
  </view>

  <!-- 系统设置 -->
  <view class="menu-section">
    <view class="section-title">系统设置</view>
    <view class="grid">
      <view class="grid-item" bindtap="goToShopInfo">
        <text class="icon">🏪</text>
        <text class="text">店铺设置</text>
      </view>
      <view class="grid-item" bindtap="showChangePassword">
        <text class="icon">🔒</text>
        <text class="text">修改密码</text>
      </view>
      <view class="grid-item" bindtap="goToPrinter">
        <text class="icon">🖨️</text>
        <text class="text">打印机管理</text>
      </view>
      <view class="grid-item" bindtap="goToPayConfig">
        <text class="icon">💳</text>
        <text class="text">支付配置</text>
      </view>
      <view class="grid-item" bindtap="goToRechargeNotice">
        <text class="icon">📝</text>
        <text class="text">充值说明</text>
      </view>
      <view class="grid-item" bindtap="subscribeNewOrder">
        <text class="icon">🔔</text>
        <text class="text">接收订单通知</text>
      </view>
    </view>
  </view>

  <!-- 公众号通知设置 -->
  <view class="menu-section" wx:if="{{useOfficialAccount}}">
    <view class="section-title">公众号通知设置</view>
    <view class="form-card">
      <view class="form-row">
        <text class="form-label">公众号 OpenID</text>
        <input class="form-input" placeholder="请输入公众号openid" value="{{mpOpenid}}" bindinput="onMpOpenidInput" />
      </view>
      <view class="tip-text">获取方式：关注公众号后发送任意消息，从公众号后台消息管理复制 OpenID</view>
      <button class="save-btn" type="primary" bindtap="saveMpOpenid" style="background-color: {{themeColor}};">保存 OpenID</button>
    </view>
  </view>

  <!-- 返回按钮 -->
  <view class="back-btn" bindtap="goBack">
    <text>返回</text>
  </view>

  <!-- 修改密码弹窗 -->
  <view class="modal-mask" wx:if="{{showPasswordModal}}" catchtap="closePasswordModal">
    <view class="modal-dialog" catchtap="stopPropagation">
      <view class="modal-title">修改密码</view>
      <view class="modal-content">
        <input class="password-input" type="password" placeholder="请输入原密码" value="{{oldPassword}}" bindinput="onOldPasswordInput" />
        <input class="password-input" type="password" placeholder="请输入新密码（至少6位）" value="{{newPassword}}" bindinput="onNewPasswordInput" />
        <input class="password-input" type="password" placeholder="请再次输入新密码" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" />
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" bindtap="closePasswordModal">取消</view>
        <view class="modal-btn confirm" bindtap="confirmChangePassword" style="color: {{themeColor}};">确认</view>
      </view>
    </view>
  </view>
</view>