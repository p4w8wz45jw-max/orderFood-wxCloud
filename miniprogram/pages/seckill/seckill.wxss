/* pages/seckill/seckill.wxss */
.page { min-height: 100vh; background: #f5f5f5; }
.header { padding: 50rpx 30rpx 40rpx; text-align: center; }
.header-title { color: #fff; font-size: 44rpx; font-weight: bold; display: block; }
.header-sub { color: rgba(255,255,255,0.8); font-size: 26rpx; margin-top: 10rpx; display: block; }

.seckill-list { padding: 20rpx 30rpx; }
.seckill-card {
  background: #fff; border-radius: 16rpx; margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06); overflow: hidden; position: relative;
}
.card-tag {
  position: absolute; top: 0; right: 0; font-size: 22rpx; padding: 8rpx 20rpx;
  border-radius: 0 16rpx 0 16rpx; color: #fff;
}
.card-img { width: 100%; height: 320rpx; display: block; }
.card-tag.active { background: #e54d42; }
.card-tag.upcoming { background: #ff9800; }
.card-tag.soldout { background: #999; }
.card-tag.ended { background: #bbb; }

.card-content { padding: 30rpx 24rpx 20rpx; }
.card-title { font-size: 34rpx; font-weight: bold; color: #333; display: block; margin-bottom: 16rpx; }
.card-price-row { display: flex; align-items: baseline; margin-bottom: 12rpx; }
.card-price { font-size: 48rpx; font-weight: bold; color: #e54d42; }
.card-stock { font-size: 24rpx; color: #999; margin-left: 16rpx; }
.card-time { font-size: 24rpx; color: #999; margin-bottom: 8rpx; }
.countdown-box {
  display: flex; align-items: center; margin-top: 6rpx;
  padding: 10rpx 16rpx; background: #fff3f3; border-radius: 8rpx;
}
.countdown-label { font-size: 24rpx; color: #e54d42; margin-right: 12rpx; }
.countdown-nums { font-size: 26rpx; color: #e54d42; font-weight: bold; font-family: monospace; letter-spacing: 2rpx; }

.card-action { padding: 0 24rpx 24rpx; }
.grab-btn {
  width: 100%; height: 80rpx; line-height: 80rpx; font-size: 30rpx; font-weight: bold;
  color: #fff; border-radius: 40rpx; border: none; text-align: center; padding: 0; margin: 0;
}
.grab-btn.disabled { background: #ccc !important; color: #999; }

.empty { text-align: center; padding: 150rpx 0; }
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
.empty-text { font-size: 32rpx; color: #999; display: block; margin-bottom: 8rpx; }
.empty-sub { font-size: 26rpx; color: #bbb; display: block; }

.loading { text-align: center; padding: 100rpx; font-size: 28rpx; color: #999; }
