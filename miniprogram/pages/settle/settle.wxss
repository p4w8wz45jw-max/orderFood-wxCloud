/* pages/settle/settle.wxss - 温暖奶油风 */

.page {
  background: #F5EDE4;
  padding-bottom: 120rpx;
}

.section {
  background: #FFFBF7;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(139, 115, 85, 0.06);
  border: 1rpx solid rgba(160, 128, 96, 0.08);
}

.order-type-display {
  text-align: center;
}

.order-type-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #5C4A3A;
}

.section-title-wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #5C4A3A;
}

.edit-order-btn {
  font-size: 26rpx;
  color: #B8956E;
}

.goods-item {
  display: flex;
  margin-bottom: 20rpx;
  align-items: center;
}

.goods-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #F0E6D8;
}

.goods-info {
  flex: 1;
}

.goods-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 4rpx;
}

.goods-name {
  font-size: 28rpx;
  color: #5C4A3A;
}

/* 会员折扣徽标（不参与 / 自定义折扣） */
.no-discount-badge {
  font-size: 20rpx;
  color: #8B7355;
  background: #F0E6D8;
  border: 1rpx solid #d8c6ac;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  white-space: nowrap;
}

/* 自定义折扣徽标 */
.no-discount-badge.custom {
  color: #a07b3c;
  background: #FDF3DD;
  border-color: #ECD9A8;
}

.goods-tags {
  margin-bottom: 4rpx;
}

.miandan-tip {
  font-size: 22rpx;
  color: #B8956E;
}

.goods-price-count {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.goods-price {
  font-size: 26rpx;
  color: #B8956E;
}

/* 余额支付折后价和原价 */
.goods-price-balance {
  font-size: 26rpx;
  font-weight: bold;
  color: #B8956E;
}

.goods-price-original {
  font-size: 22rpx;
  color: #B0A090;
  text-decoration: line-through;
}

.goods-count {
  font-size: 26rpx;
  color: #8B7355;
}

/* 余额支付小计 */
.goods-subtotal {
  font-size: 28rpx;
  font-weight: bold;
  color: #5C4A3A;
}

.goods-subtotal-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.goods-subtotal-balance {
  font-size: 28rpx;
  font-weight: bold;
  color: #B8956E;
}

.goods-subtotal-original {
  font-size: 22rpx;
  color: #B0A090;
  text-decoration: line-through;
}

/* 余额支付95折标签 */
.balance-discount-tag {
  display: inline-block;
  background: #e54d42;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
  line-height: 1.4;
}

.pay-method-title-wrap {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

/* 余额支付优惠说明 */
.balance-discount-info {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #FFF8F0, #FFF3E8);
  border-radius: 10rpx;
  border-left: 4rpx solid #e54d42;
}

.discount-info-text {
  font-size: 24rpx;
  color: #e54d42;
  font-weight: 500;
}

/* 底部合计 */
.footer-price-wrap {
  display: flex;
  flex-direction: column;
}

.footer-price {
  display: flex;
  align-items: baseline;
}

.pay-method-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pay-method-item {
  background: #FAF6F1;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.pay-method-item.active {
  border-color: #B8956E;
  background: #FBF3EB;
}

/* 余额支付禁用态（余额为0时置灰不可选择） */
.pay-method-item.disabled {
  opacity: 0.55;
  background: #F2ECE3;
  border-color: #E8DDD0;
}

.pay-method-item.disabled .pay-method-title {
  color: #B0A090;
}

.pay-method-item.disabled .pay-method-desc {
  color: #C0B0A0;
}

.pay-method-item.disabled .pay-method-radio {
  border-color: #D8CCC0;
}

/* 余额为0时的充值引导（会员卡整单95折，点击去充值） */
.recharge-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 20rpx;
  background: linear-gradient(135deg, #FFF8F0, #FFF3E8);
  border-radius: 10rpx;
  border: 1rpx dashed #E8B88A;
  font-size: 24rpx;
  color: #B8956E;
}

.recharge-tip:active {
  background: #FBF3EB;
}

.recharge-link {
  color: #e54d42;
  font-weight: bold;
  margin-left: 8rpx;
  text-decoration: underline;
}

.pay-method-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pay-method-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  color: #5C4A3A;
}

.pay-method-desc {
  font-size: 24rpx;
  color: #8B7355;
}

.pay-method-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #D4C4AC;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pay-method-radio.checked {
  border-color: #B8956E;
}

.radio-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #B8956E;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFBF7;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 12rpx rgba(92, 74, 58, 0.08);
  border-top: 1rpx solid rgba(160, 128, 96, 0.10);
}

.footer-price-wrap {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.footer-price {
  display: flex;
  align-items: baseline;
}

.footer-price-original {
  font-size: 24rpx;
  color: #B0A090;
  text-decoration: line-through;
  line-height: 1.2;
}

.footer-label {
  font-size: 28rpx;
  color: #5C4A3A;
}

.footer-price-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #B8956E;
}

.footer-discount-tip {
  font-size: 22rpx;
  color: #e54d42;
  font-weight: 500;
  line-height: 1.2;
}

.submit-btn {
  background: #B8956E;
  color: #fff;
  padding: 18rpx 50rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.submit-btn.disabled {
  background: #D4C4AC;
}

/* 配送表单样式 */
.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 30rpx;
  margin-bottom: 10rpx;
  font-weight: 500;
  color: #5C4A3A;
}

.form-input {
  width: 100%;
  height: 90rpx;
  border: 2rpx solid #E8DDD0;
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  background: #FFFBF7;
  color: #5C4A3A;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  border: 2rpx solid #E8DDD0;
  border-radius: 12rpx;
  padding: 15rpx 20rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  background: #FFFBF7;
  color: #5C4A3A;
}

.table-code-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.table-code-label {
  font-size: 28rpx;
  color: #8B7355;
}

.table-code-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #5C4A3A;
}

.change-table-btn {
  font-size: 26rpx;
  color: #B8956E;
  padding: 10rpx 20rpx;
  border: 2rpx solid #B8956E;
  border-radius: 30rpx;
}
/* 结算页配送方式显示 */
.delivery-display {
  text-align: center;
  padding: 24rpx;
  background: #F5EDDF;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #6B9E6B;
}

/* 配送费展示 */
.delivery-fee-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 16rpx;
}

.delivery-fee-label {
  font-size: 26rpx;
  color: #8B7355;
}

.delivery-fee-value {
  font-size: 30rpx;
  font-weight: bold;
  color: #e54d42;
}

.delivery-fee-value.free {
  color: #07c160;
}

.delivery-fee-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #B0A090;
}

.delivery-fee-tip-text {
  font-size: 22rpx;
  color: #B8956E;
}
/* 优惠券行样式 */
.coupon-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(160, 128, 96, 0.10);
}

.coupon-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.coupon-icon {
  font-size: 48rpx;
}

.coupon-info {
  display: flex;
  flex-direction: column;
}

.coupon-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #5C4A3A;
}

.coupon-placeholder {
  font-size: 28rpx;
  color: #8B7355;
}

.coupon-desc {
  font-size: 24rpx;
  color: #8B7355;
}

.coupon-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.discount-amount {
  color: #B8956E;
  font-size: 30rpx;
  font-weight: bold;
}

.arrow {
  color: #D4C4AC;
  font-size: 40rpx;
}

.cancel-coupon {
  text-align: right;
  font-size: 24rpx;
  color: #8B7355;
  padding: 10rpx 0;
}

/* 拼团优惠行 */
.group-buy-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(160, 128, 96, 0.10);
}
.group-buy-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.group-buy-tag {
  background: #B8956E;
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}
.group-buy-info {
  display: flex;
  flex-direction: column;
}
.group-buy-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #5C4A3A;
}
.group-buy-location {
  font-size: 24rpx;
  color: #8B7355;
  margin-top: 4rpx;
}
.group-buy-right {
  display: flex;
  align-items: center;
}

/* 优惠券弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(92, 74, 58, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-dialog {
  width: 650rpx;
  max-height: 70%;
  background: #FFFBF7;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  border: 1rpx solid rgba(160, 128, 96, 0.10);
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  padding: 30rpx;
  border-bottom: 1rpx solid rgba(160, 128, 96, 0.10);
  color: #5C4A3A;
}

.coupon-list {
  max-height: 500rpx;
  padding: 20rpx;
}

.coupon-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FAF6F1;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-left: 8rpx solid #B8956E;
}

.coupon-item-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.coupon-item-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #5C4A3A;
}

.coupon-item-desc {
  font-size: 24rpx;
  color: #8B7355;
}

.coupon-item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.coupon-item-value {
  color: #B8956E;
  font-size: 28rpx;
  font-weight: bold;
}

.radio-btn {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #D4C4AC;
  border-radius: 50%;
}

.empty-tip {
  text-align: center;
  padding: 60rpx;
  color: #8B7355;
  font-size: 28rpx;
}

.modal-footer {
  border-top: 1rpx solid rgba(160, 128, 96, 0.10);
  padding: 20rpx;
}

.modal-btn {
  text-align: center;
  padding: 20rpx;
  font-size: 32rpx;
  border-radius: 12rpx;
}

.modal-btn.cancel {
  background: #F5EDE4;
  color: #8B7355;
}
/* 配送方式切换按钮 */
.delivery-switch {
  display: flex;
  gap: 30rpx;
  padding: 20rpx 0;
}

.delivery-option {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 50rpx;
  background: #F5EDE4;
  color: #8B7355;
  font-size: 28rpx;
  transition: all 0.3s;
}

.delivery-option.active {
  background: #B8956E;
  color: #fff;
}
/* 配送方式行 */
.delivery-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.delivery-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #5C4A3A;
}

.delivery-switch-text {
  font-size: 26rpx;
  color: #B8956E;
  padding: 10rpx 20rpx;
  border: 2rpx solid #B8956E;
  border-radius: 30rpx;
  background: #FFFBF7;
}

.delivery-switch-text:active {
  background: #FBF3EB;
}
.time-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #FAF6F1;
  border-radius: 12rpx;
  margin-top: 20rpx;
}
.time-value {
  color: #5C4A3A;
  font-size: 28rpx;
}
.arrow {
  color: #8B7355;
  font-size: 36rpx;
}

/* 配送费行 */
.delivery-fee-row {
  display: flex;
  align-items: center;
}

.delivery-fee-label {
  font-size: 28rpx;
  color: #5C4A3A;
}

.delivery-fee-value {
  font-size: 28rpx;
  color: #5C4A3A;
  font-weight: 500;
}

.delivery-fee-value.free {
  font-weight: bold;
}

.delivery-fee-tip {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: linear-gradient(135deg, #FFF8F0, #FFF3E8);
  border-radius: 8rpx;
  border-left: 4rpx solid #B8956E;
}

.delivery-fee-tip-text {
  font-size: 22rpx;
  color: #B8956E;
  font-weight: 500;
}

/* ========== 结算成功抽奖弹窗样式 ========== */
.reward-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(92, 74, 58, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}
.reward-popup-container {
  width: 80%;
  background: #FFFBF7;
  border-radius: 24rpx;
  text-align: center;
  overflow: hidden;
  border: 1rpx solid rgba(160, 128, 96, 0.10);
}
.reward-popup-image {
  width: 100%;
  display: block;
}
.reward-btns {
  display: flex;
  border-top: 1rpx solid rgba(160, 128, 96, 0.10);
}
.reward-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  font-size: 32rpx;
}
.reward-btn.cancel {
  color: #8B7355;
  border-right: 1rpx solid rgba(160, 128, 96, 0.10);
}
.reward-btn.confirm {
  color: #6B9E6B;
  font-weight: bold;
}
.payment-detail {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #FAF6F1;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #8B7355;
}
.detail-label {
  font-weight: bold;
  margin-bottom: 10rpx;
  display: block;
  color: #5C4A3A;
}
.detail-items text {
  margin-right: 20rpx;
}
/* ========== 时间段选择弹窗 ========== */
.time-modal-dialog {
  background: #FFFBF7;
  border-radius: 24rpx;
  width: 80vw;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.time-modal-title {
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #5C4A3A;
  text-align: center;
  border-bottom: 1rpx solid #F0E6D8;
  flex-shrink: 0;
}
.time-modal-content {
  max-height: 60vh;
  padding: 16rpx;
  box-sizing: border-box;
  overflow-x: hidden;
}
.time-option {
  display: block;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 20rpx;
  font-size: 30rpx;
  color: #5C4A3A;
  border: 2rpx solid #F0E6D8;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  text-align: center;
  background: #FFFBF7;
}
.time-option.active {
  font-weight: bold;
}
.time-modal-footer {
  padding: 20rpx;
  display: flex;
  justify-content: center;
  border-top: 1rpx solid #F0E6D8;
  flex-shrink: 0;
}
.modal-btn.cancel {
  padding: 12rpx 60rpx;
  background: #F5EDE4;
  color: #8B7355;
  border-radius: 40rpx;
  font-size: 28rpx;
}
