<!-- pages/couponCenter/couponCenter.wxml -->
<view class="container">
  <view class="header" style="background-color: {{themeColor}};">
    <text class="header-title">优惠券中心</text>
    <text class="header-desc">超值套票，一次购买多张优惠券</text>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view class="package-list" wx:else>
    <view class="package-card" wx:for="{{packages}}" wx:key="_id" data-pkg="{{item}}" bindtap="buyPackage">
      <view class="package-header">
        <text class="package-name">{{item.name}}</text>
        <text class="package-price">¥{{item.price}}</text>
      </view>
      <view class="package-body">
        <text class="package-count">包含 {{item.couponCount}} 张</text>
        <text class="package-coupon">{{item.couponName}}</text>
      </view>
      <view class="package-footer">
        <text class="package-expire">有效期：{{item.expireDays}}天</text>
        <view class="buy-btn" style="background-color: {{themeColor}};">立即购买</view>
      </view>
    </view>
    <view wx:if="{{packages.length === 0}}" class="empty">暂无套票，敬请期待</view>
  </view>

  <view class="footer-tip">
    <text>温馨提示：套票仅支持微信支付</text>
  </view>
</view>