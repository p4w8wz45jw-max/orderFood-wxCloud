/* pages/couponCenter/couponCenter.wxss - 温暖奶油风 */
.container {
  background: #F5EDE4;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.header {
  padding: 60rpx 40rpx 40rpx;
  color: white;
}
.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}
.header-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: #A09888;
}

.package-list {
  padding: 20rpx;
}
.package-card {
  background: #FFFBF7;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(139,115,85,0.05);
  border: 1rpx solid rgba(160,128,96,0.06);
}
.package-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(160,128,96,0.08);
}
.package-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #5C4A3A;
}
.package-price {
  font-size: 40rpx;
  font-weight: bold;
  color: #D4A574;
}
.package-price::before {
  content: '¥';
  font-size: 28rpx;
}
.package-body {
  margin-bottom: 20rpx;
}
.package-count {
  display: block;
  font-size: 28rpx;
  color: #8B7355;
  margin-bottom: 8rpx;
}
.package-coupon {
  display: block;
  font-size: 26rpx;
  color: #A09888;
}
.package-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(160,128,96,0.08);
}
.package-expire {
  font-size: 24rpx;
  color: #A09888;
}
.buy-btn {
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  color: white;
  font-size: 28rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #B8956E, #A68A55);
}
.empty {
  text-align: center;
  padding: 100rpx;
  color: #A09888;
}
.footer-tip {
  text-align: center;
  padding: 30rpx;
  color: #A09888;
  font-size: 24rpx;
}
