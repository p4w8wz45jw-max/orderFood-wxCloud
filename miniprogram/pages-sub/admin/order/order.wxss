/* pages/admin/order/order.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
  padding-bottom: 40rpx;
}

/* 筛选栏 */
.filter-bar {
  background: white;
  border-radius: 20rpx;
  padding: 10rpx 20rpx 20rpx;
  margin-bottom: 20rpx;
}

.refresh-bar {
  margin-top: 10rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 15rpx;
}

.refresh-btn {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e54d42;
  color: #e54d42;
  font-size: 24rpx;
}

.refresh-tip {
  font-size: 22rpx;
  color: #999;
}

/* 订单列表 */
.order-list {
  flex: 1;
  padding: 20rpx;
}

.order-item {
  background: white;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-user-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #f5f5f5;
}

.user-info-text {
  flex: 1;
}

.user-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 5rpx;
}

.user-phone {
  font-size: 24rpx;
  color: #3b82f6;
  line-height: 1.6;
}

.order-type-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.order-type {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

/* 支付方式标签 */
.pay-method-tag {
  font-size: 22rpx;
  color: #fff;
  background: #07c160;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

/* 退款状态标签 */
.refund-badge {
  display: flex;
  justify-content: flex-end;
  padding: 10rpx 30rpx 0;
}

.refund-badge text {
  font-size: 22rpx;
  color: #ff6b6b;
  background: rgba(255, 107, 107, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(255, 107, 107, 0.3);
  font-weight: 500;
}

/* 订单内容 */
.order-content {
  padding: 30rpx;
}

/* 取餐/配送时间行 */
.time-label-row {
  display: flex;
  align-items: center;
  padding: 14rpx 20rpx;
  margin-bottom: 16rpx;
  background: #f0fdf4;
  border-radius: 10rpx;
  border-left: 4rpx solid #22c55e;
}

.time-label {
  font-size: 26rpx;
  color: #22c55e;
  font-weight: bold;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.time-value {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
}

/* 配送地址行 */
.delivery-addr-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  background: #f0f9ff;
  border-radius: 10rpx;
  border-left: 4rpx solid #3b82f6;
}

.delivery-addr-text {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.addr-label {
  color: #3b82f6;
  font-weight: bold;
}

.copy-addr-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #3b82f6;
  background: rgba(59, 130, 246, 0.1);
  border: 1rpx solid #3b82f6;
  border-radius: 8rpx;
}

/* 充值订单信息 */
.recharge-info {
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

.recharge-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.recharge-item:last-child {
  margin-bottom: 0;
}

.recharge-label {
  font-size: 28rpx;
  color: #666;
}

.recharge-value {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.recharge-value.gift {
  color: #ff6b6b;
}

.recharge-value.total {
  color: #e54d42;
  font-size: 36rpx;
}

/* 点餐订单商品列表 */
.goods-list {
  margin-bottom: 20rpx;
}

.goods-item {
  display: flex;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.goods-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

/* 商品标签 */
.goods-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.tag-text {
  font-size: 22rpx;
  color: #e54d42;
  background: rgba(229, 77, 66, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(229, 77, 66, 0.3);
}

.goods-detail {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goods-price {
  font-size: 28rpx;
  color: #e54d42;
  font-weight: bold;
}

.goods-count {
  font-size: 26rpx;
  color: #999;
}

/* 免单标识 */
.miandan-tag {
  background: linear-gradient(135deg, #ff9a9e 0%, #fad0c4 100%);
  color: white;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  text-align: center;
  margin-top: 10rpx;
}

/* 订单合计 */
.order-total {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  font-size: 28rpx;
  color: #333;
  margin-top: 10rpx;
}

/* 优惠券信息行 */
.coupon-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 12rpx;
  background: #fffbeb;
  border-radius: 10rpx;
  border-left: 4rpx solid #f59e0b;
}

.coupon-name {
  flex: 1;
  font-size: 24rpx;
  color: #b45309;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-source-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.12);
  border: 1rpx solid rgba(245, 158, 11, 0.35);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.total-price {
  font-size: 32rpx;
  color: #e54d42;
  font-weight: bold;
}

.pay-detail {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
}

/* 订单底部 */
.order-footer {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f5f5f5;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-actions {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.order-info {
  text-align: right;
  margin-bottom: 15rpx;
}

.order-table-code {
  font-size: 24rpx;
  color: #38b2ac;
  font-weight: 500;
  margin-top: 5rpx;
}

.order-print-status {
  margin-top: 8rpx;
}

.print-status-text {
  font-size: 24rpx;
  font-weight: 500;
}

.print-status-text.printed {
  color: #07c160;
}

.print-status-text.failed {
  color: #ee0a24;
}

.print-status-text.cancelled {
  color: #999;
}

.print-status-text.not-printed {
  color: #ff9500;
}

/* 重新打印按钮 */
.reprint-btn {
  margin: 0 !important;
  font-size: 24rpx !important;
}

/* 退款按钮 */
.refund-btn {
  margin: 0 !important;
  font-size: 24rpx !important;
  background: #ff6b6b !important;
  color: #fff !important;
  border: none !important;
  border-radius: 8rpx !important;
}

/* 已退款文字 */
.refunded-text {
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.price-label {
  font-size: 26rpx;
  color: #666;
}

.price-num {
  font-size: 36rpx;
  color: #e54d42;
  font-weight: bold;
  margin-left: 10rpx;
}

.action-btns {
  display: flex;
  gap: 15rpx;
}

.action-btn {
  padding: 12rpx 30rpx;
  border-radius: 50rpx;
  font-size: 26rpx;
  text-align: center;
}

.action-btn.delete {
  background: rgba(245, 108, 108, 0.1);
  color: #f56c6c;
  border: 1rpx solid #f56c6c;
}

/* 秒杀订单标记 */
.seckill-banner {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, #fff3f3, #fff0f0);
  border-left: 6rpx solid #e54d42;
  border-radius: 8rpx;
}
.seckill-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}
.seckill-banner-text {
  font-size: 26rpx;
  color: #e54d42;
  font-weight: bold;
}
