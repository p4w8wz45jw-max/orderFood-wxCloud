/* ========================================
   精致现代登录弹窗样式
   ======================================== */

/* ---- 遮罩 ---- */
.modal-root {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  background: rgba(0, 0, 0, 0.50);
  animation: maskIn 0.25s ease;
}
@keyframes maskIn {
  from { background: rgba(0, 0, 0, 0); }
  to   { background: rgba(0, 0, 0, 0.50); }
}

/* ---- 卡片 ---- */
.modal-card {
  position: relative;
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  animation: cardPop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes cardPop {
  from { transform: scale(0.88); opacity: 0; }
  to   { transform: scale(1);    opacity: 1; }
}

/* ---- 顶部装饰 ---- */
.top-accent {
  height: 8rpx;
  background: linear-gradient(90deg, #B8956E 0%, #D4B896 40%, #C49A6C 100%);
}

/* ---- 关闭按钮 ---- */
.close-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 1;
  padding: 8rpx;
}
.close-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F2F2F2;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}
.close-icon-wrap:active {
  background: #E5E5E5;
}
.close-icon {
  font-size: 24rpx;
  color: #999;
  font-weight: 300;
}

/* ---- 头部 ---- */
.modal-header {
  text-align: center;
  padding: 44rpx 40rpx 30rpx;
}
.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  letter-spacing: 2rpx;
}
.modal-desc {
  display: block;
  font-size: 24rpx;
  color: #B8956E;
  margin-top: 12rpx;
}

/* ---- 头像 ---- */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
}
.avatar-btn {
  background: none;
  border: none;
  padding: 0;
  line-height: 1;
}
.avatar-btn::after { border: none; }

.avatar-frame {
  position: relative;
  width: 144rpx;
  height: 144rpx;
}
.avatar-ring {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  padding: 6rpx;
  background: linear-gradient(135deg, #D4B896, #C49A6C, #B8956E);
}
.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #F5F0E8;
}
.camera-dot {
  position: absolute;
  bottom: 6rpx;
  right: 6rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #B8956E, #A08060);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 3rpx 10rpx rgba(139, 115, 85, 0.25);
}
.camera-emoji {
  font-size: 20rpx;
}
.avatar-tip {
  font-size: 24rpx;
  color: #A09888;
  margin-top: 16rpx;
}

/* ---- 表单 ---- */
.form-section {
  margin: 0 36rpx 8rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid #F0EBE3;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  min-height: 100rpx;
  background: #FFFDF8;
  border-bottom: 1rpx solid #F0EBE3;
}
.form-item:last-child {
  border-bottom: none;
}

.form-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.nick-icon {
  background: #FFF3E0;
}
.phone-icon {
  background: #F3E5F5;
}
.icon-text {
  font-size: 28rpx;
}

.form-body {
  flex: 1;
  min-width: 0;
}
.form-label {
  font-size: 22rpx;
  color: #B0A090;
  display: block;
  margin-bottom: 4rpx;
}
.form-input {
  font-size: 28rpx;
  color: #333333;
  height: 40rpx;
  line-height: 40rpx;
}
.form-value {
  font-size: 28rpx;
  color: #B0A090;
}

.form-arrow {
  font-size: 32rpx;
  color: #D0C8B8;
  flex-shrink: 0;
  font-weight: bold;
}

.phone-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #8B5CF6, #7C3AED);
  border-radius: 28rpx;
  padding: 12rpx 28rpx;
  line-height: 1;
  border: none;
  font-weight: 500;
  box-shadow: 0 4rpx 14rpx rgba(124, 58, 237, 0.30);
}
.phone-btn::after { border: none; }
.phone-btn:active {
  opacity: 0.85;
  transform: scale(0.96);
}

/* ---- 底部 ---- */
.footer-area {
  padding: 36rpx 36rpx 32rpx;
}
.submit-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #EF4444 0%, #DC2626 100%);
  color: #FFFFFF;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  border: none;
  box-shadow: 0 6rpx 22rpx rgba(220, 38, 38, 0.30);
}
.submit-btn::after { border: none; }
.submit-btn:active {
  opacity: 0.88;
  transform: scale(0.98);
}

.skip-text {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #C4B5A0;
  margin-top: 22rpx;
  padding: 8rpx 0;
}
