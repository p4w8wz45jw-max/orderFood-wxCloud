.page {
  padding: 30rpx;
}
.form-item {
  margin-bottom: 40rpx;
}
.form-label {
  font-size: 32rpx;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 30rpx 0 20rpx;
}
.rule-list {
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
}
.rule-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}
.rule-info {
  display: flex;
  flex-direction: column;
}
.rule-name {
  font-size: 30rpx;
  font-weight: bold;
}
.rule-points {
  font-size: 26rpx;
  color: #ff6b6b;
  margin-top: 6rpx;
}
.rule-type {
  font-size: 24rpx;
  color: #999;
}
.rule-actions {
  display: flex;
  gap: 20rpx;
}
.edit { color: #07c160; }
.delete { color: #ff6b6b; }
.empty-tip {
  text-align: center;
  color: #999;
  padding: 40rpx;
}
.add-btn {
  margin-top: 40rpx;
}
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.modal-dialog {
  width: 85%;
  max-width: 600rpx;
  background: white;
  border-radius: 24rpx;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}
.modal-title {
  text-align: center;
  padding: 30rpx;
  font-size: 36rpx;
  font-weight: bold;
  border-bottom: 1rpx solid #eee;
}
.modal-content {
  padding: 30rpx;
  flex: 1;
  max-height: 60vh;
}
.modal-item {
  margin-bottom: 30rpx;
}
.modal-item text {
  display: block;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}
.modal-item input, .modal-item picker {
  width: 100%;
  border: 1rpx solid #ddd;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}
.modal-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  font-size: 32rpx;
}
.cancel { color: #666; }
.confirm { color: #07c160; }
.picker-display {
  width: 100%;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  border: 1rpx solid #ddd;
}
.picker-display .placeholder {
  color: #999;
}
.image-upload {
  width: 160rpx;
  height: 160rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1rpx dashed #ddd;
}
.image-upload image {
  width: 100%;
  height: 100%;
}
.upload-placeholder {
  font-size: 40rpx;
  color: #ccc;
}
.remove-image {
  font-size: 24rpx;
  color: #ff6b6b;
  margin-top: 10rpx;
  text-align: center;
}