/* pages/address/edit/edit.wxss - 温暖奶油风 */
.container {
    padding: 30rpx;
    background: #F5EDE4;
    min-height: 100vh;
}
.form-item {
    background: #FFFBF7;
    margin-bottom: 20rpx;
    padding: 20rpx 30rpx;
    display: flex;
    align-items: center;
    border-radius: 12rpx;
    border: 1rpx solid rgba(160,128,96,0.08);
}
.form-item text {
    width: 160rpx;
    font-size: 30rpx;
    color: #5C4A3A;
}
.form-item input,
.picker {
    flex: 1;
    font-size: 30rpx;
    padding: 20rpx 0;
    min-height: 80rpx;
    line-height: 1.4;
    color: #5C4A3A;
}
.switch-item {
    justify-content: space-between;
}
.switch-item text {
    width: auto;
}
.save-btn {
    margin-top: 60rpx;
    background-color: #B8956E;
    border-radius: 50rpx;
    color: white;
}
